    {
      "id": "_opencode_skills_openspec_propose_planning_boundary",
      "label": "Planning Boundary Principle",
      "file_type": "rationale",
      "source_file": "D:\\kairos\\kairos\\.opencode\\skills\\openspec-propose\\SKILL.md",
      "source_location": "line 15",
      "source_url": null,
      "captured_at": null,
      "author": "openspec",
      "contributor": null,
      "rationale": "The user request that triggers propose authorizes planning only - even if it asks to build or fix something. Implementation must wait for an explicit new request starting the apply workflow, preventing accidental code edits during artifact generation."
    },
    {
      "id": "_opencode_skills_openspec_explore_explore_mode_stance",
      "label": "Explore Mode Stance",
      "file_type": "rationale",
      "source_file": "D:\\kairos\\kairos\\.opencode\\skills\\openspec-explore\\SKILL.md",
      "source_location": "lines 13-17",
      "source_url": null,
      "captured_at": null,
      "author": "openspec",
      "contributor": null,
      "rationale": "Explore mode is a stance, not a workflow: thinking partner behavior with no fixed steps. Never write code while exploring; creating OpenSpec artifacts counts as capturing thinking, not implementing."
    },
    {
      "id": "_opencode_skills_openspec_sync_specs_intelligent_merge",
      "label": "Intelligent Merging",
      "file_type": "rationale",
      "source_file": "D:\\kairos\\kairos\\.opencode\\skills\\openspec-sync-specs\\SKILL.md",
      "source_location": "lines 226-231",
      "source_url": null,
      "captured_at": null,
      "author": "openspec",
      "contributor": null,
      "rationale": "Unlike programmatic merging, the agent merges rather than overwrites: preserve scenarios/content the delta does not mention, keep main spec order, and never copy delta operation headers into main specs."
    },
    {
      "id": "_opencode_skills_openspec_apply_change_fluid_workflow",
      "label": "Fluid Workflow Model",
      "file_type": "rationale",
      "source_file": "D:\\kairos\\kairos\\.opencode\\skills\\openspec-apply-change\\SKILL.md",
      "source_location": "lines 183-188",
      "source_url": null,
      "captured_at": null,
      "author": "openspec",
      "contributor": null,
      "rationale": "Supports the 'actions on a change' model: apply can run before all artifacts are done, interleaved with other actions, and implementation revealing design issues should loop back into artifact updates rather than staying phase-locked."
    },
    {
      "id": "_opencode_skills_openspec_sync_specs_capability_retirement",
      "label": "Capability Retirement Rules",
      "file_type": "rationale",
      "source_file": "D:\\kairos\\kairos\\.opencode\\skills\\openspec-sync-specs\\SKILL.md",
      "source_location": "lines 113-136",
      "source_url": null,
      "captured_at": null,
      "author": "openspec",
      "contributor": null,
      "rationale": "A main spec.md may only be deleted when ALL conditions hold: no requirement blocks remain, spec still well-formed with ## Purpose, was not already empty, every remaining line accounted for, .openspec.yaml declares retire_capabilities: true, and path resolves inside the real specs root. Prevents accidental capability deletion."
    },
